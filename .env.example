# ===== LLM 配置 =====
OPENAI_BASE_URL=https://your-llm-provider.com/v1
OPENAI_API_KEY=sk-你的密钥

# 模型名称（按你实际使用的填）
LLM_QWEN3.5=qwen3.5
LLM_QWEN3=qwen3
LLM_QWEN_PLUS=qwen-plus

# ===== 网络搜索工具 =====
TAVILY_API_KEY=tvly-你的密钥

# ===== 数据库 =====
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=your_database
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ===== RAGFlow =====
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=ragflow-你的密钥